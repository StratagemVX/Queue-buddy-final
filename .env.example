# Frontend Supabase configuration (copy to .env.local or .env and supply real values locally)
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional compatibility alias when needed by tooling
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Edge Function runtime secrets (configure with `supabase secrets set`, never commit)
# CORS_ALLOWED_ORIGINS=https://your-app.example.com
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
